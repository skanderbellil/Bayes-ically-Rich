__pycache__/
*.py[cod]
*.egg-info/
.env
.venv/
venv/
results/
*.png
*.csv
# Bundled datasets are tracked despite the *.csv rule above
!datasets/*.csv
# Smart-money wallet-selection test snapshot (committed for reproducibility)
!data/polymarket_smart_money_snapshot/*.csv
# Regime-calibration study: panel + cached token histories (valuable; keep)
!data/polymarket_calibration_snapshot/*.csv
!data/polymarket_calibration_snapshot/*.png
# Paper-trade ledgers, studies and plots are tracked (the forward out-of-sample
# record). Blanket un-ignore instead of enumerating files: a new strategy's
# ledger silently never committed when it was missing from this list (the
# hourly cron's `git add` failed on it, masked by `|| true`), so its forward
# history was wiped every run — see docs/REPO_REVIEW_2026-07-01.md §2.7.
!data/paper_trade/*.csv
!data/paper_trade/*.png
!data/paper_trade/insider_scorecard
.DS_Store
.claude/

# Polymarket/PEAD runtime fetch caches (created on demand)
data/raw/

# Graphify knowledge-graph build cache
graphify-out/cache/

# Mid-price × smart-flow combo study snapshot (committed for reproducibility)
!data/polymarket_combo_snapshot/*.csv
!data/polymarket_combo_snapshot/*.png

# Crypto strategy panel (notebooks/crypto_strategy_verdict.ipynb).
# The raw per-request JSON fetch cache is large (~21MB) and fully rebuildable by
# experiments/build_crypto_panel.py, so it stays local. The consolidated panel it
# produces IS committed, so the notebook re-runs offline and reproduces exactly.
data/crypto_panel/raw/
!data/crypto_panel/universe.csv
!data/crypto_panel/perp_listings.csv
!data/crypto_panel/liquidity.csv
!data/crypto_panel/venues.csv

# Binance 1-minute klines (notebooks/crypto_frequency_verdict.ipynb).
# ~209MB of parquet, fully rebuildable in a few minutes by
# experiments/fetch_intraday_klines.py, so it stays local like the other caches.
data/crypto_intraday/
